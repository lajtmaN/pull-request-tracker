# Copy to .env (git-ignored) and adjust. Real environment variables take precedence.

# Only track PRs in these orgs, comma-separated (default: every repo you can see)
PRS_ORGS=my-org,other-org

# Strip a shared repo-name prefix in the PR column, e.g. my-org-web-app#12 -> web-app#12
PRS_STRIP_PREFIX=my-org-

# Live view: seconds between syncs with GitHub
PRS_INTERVAL=60

# `prs once`: minutes before a saved sync counts as stale and is refetched
PRS_MAX_AGE=30

# Whose PRs to track (default: the account `gh` is logged in as)
# PRS_ME=my-login
